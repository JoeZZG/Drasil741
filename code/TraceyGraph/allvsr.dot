digraph "allvsr" {
    "instance:predictTrajectory" -> "theory:stateEvolRC";
    "instance:determineDetectorOutcome" -> "theory:detHitRC";
    "instance:buildRegionGrid" -> "dataDefn:Ri";
    "instance:lookupActiveRegion" -> "dataDefn:Ei";
    "instance:computeTraj" -> "theory:stateEvolRC";
    "instance:reportOutputs" -> "theory:stateEvolRC";
    "instance:reportOutputs" -> "theory:detHitRC";
    "instance:piecewiseUniform" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:piecewiseUniform"];
    "instance:singleParticle" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:singleParticle"];
    "instance:noInteractions" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:noInteractions"];
    "instance:prescribedFields" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:prescribedFields"];
    "instance:twoDMotion" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:twoDMotion"];
    "instance:bPerpPlane" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:bPerpPlane"];
    "instance:eAxisAligned" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:eAxisAligned"];
    "instance:rectRegions" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:rectRegions"];
    "instance:gridLayout" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:gridLayout"];
    "instance:lineDetector" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:lineDetector"];
    "instance:fullDetection" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:fullDetection"];
    "instance:lorentzOnly" [shape=box, color=black, style=filled, fillcolor="mistyrose", label="A:lorentzOnly"];
    subgraph "A" {
        rank="same";
        "instance:piecewiseUniform" "instance:singleParticle" "instance:noInteractions" "instance:prescribedFields" "instance:twoDMotion" "instance:bPerpPlane" "instance:eAxisAligned" "instance:rectRegions" "instance:gridLayout" "instance:lineDetector" "instance:fullDetection" "instance:lorentzOnly";
    }
    "dataDefn:kappa" [shape=box, color=black, style=filled, fillcolor="paleturquoise1", label="DD:qOverm"];
    "dataDefn:s0" [shape=box, color=black, style=filled, fillcolor="paleturquoise1", label="DD:initState"];
    "dataDefn:Evec" [shape=box, color=black, style=filled, fillcolor="paleturquoise1", label="DD:eField"];
    "dataDefn:Bvec" [shape=box, color=black, style=filled, fillcolor="paleturquoise1", label="DD:bField"];
    "dataDefn:Ri" [shape=box, color=black, style=filled, fillcolor="paleturquoise1", label="DD:regionRect"];
    "dataDefn:Ei" [shape=box, color=black, style=filled, fillcolor="paleturquoise1", label="DD:fieldsByRegion"];
    "dataDefn:d_orient" [shape=box, color=black, style=filled, fillcolor="paleturquoise1", label="DD:detectorLine"];
    subgraph "DD" {
        rank="same";
        "dataDefn:kappa" "dataDefn:s0" "dataDefn:Evec" "dataDefn:Bvec" "dataDefn:Ri" "dataDefn:Ei" "dataDefn:d_orient";
    }
    "theory:velocityTM" [shape=box, color=black, style=filled, fillcolor="pink", label="TM:velocity"];
    "theory:accelerationTM" [shape=box, color=black, style=filled, fillcolor="pink", label="TM:acceleration"];
    "theory:lorentzForceCS" [shape=box, color=black, style=filled, fillcolor="pink", label="TM:lorentzForce"];
    "theory:eqnMotionCS" [shape=box, color=black, style=filled, fillcolor="pink", label="TM:eqnMotion"];
    subgraph "TM" {
        rank="same";
        "theory:velocityTM" "theory:accelerationTM" "theory:lorentzForceCS" "theory:eqnMotionCS";
    }
    "theory:kin2DRC" [shape=box, color=black, style=filled, fillcolor="palegreen", label="GD:kin2D"];
    "theory:vCrossB" [shape=box, color=black, style=filled, fillcolor="palegreen", label="GD:vCrossB2D"];
    "theory:dyn2DRC" [shape=box, color=black, style=filled, fillcolor="palegreen", label="GD:dyn2D"];
    subgraph "GD" {
        rank="same";
        "theory:kin2DRC" "theory:vCrossB" "theory:dyn2DRC";
    }
    "theory:stateEvolRC" [shape=box, color=black, style=filled, fillcolor="khaki1", label="IM:stateEvol"];
    "theory:detHitRC" [shape=box, color=black, style=filled, fillcolor="khaki1", label="IM:detHit"];
    subgraph "IM" {
        rank="same";
        "theory:stateEvolRC" "theory:detHitRC";
    }
    "instance:inputValues" [shape=box, color=black, style=filled, fillcolor="ivory", label="FR:inputValues"];
    "instance:echoInputs" [shape=box, color=black, style=filled, fillcolor="ivory", label="FR:echoInputs"];
    "instance:buildRegionGrid" [shape=box, color=black, style=filled, fillcolor="ivory", label="FR:buildRegionGrid"];
    "instance:lookupActiveRegion" [shape=box, color=black, style=filled, fillcolor="ivory", label="FR:lookupActiveRegion"];
    "instance:computeTraj" [shape=box, color=black, style=filled, fillcolor="ivory", label="FR:computeTraj"];
    "instance:reportOutputs" [shape=box, color=black, style=filled, fillcolor="ivory", label="FR:reportOutputs"];
    "instance:correct" [shape=box, color=black, style=filled, fillcolor="ivory", label="NFR:correct"];
    "instance:maintainable" [shape=box, color=black, style=filled, fillcolor="ivory", label="NFR:maintainable"];
    "instance:portable" [shape=box, color=black, style=filled, fillcolor="ivory", label="NFR:portable"];
    subgraph "FR" {
        rank="same";
        "instance:inputValues" "instance:echoInputs" "instance:buildRegionGrid" "instance:lookupActiveRegion" "instance:computeTraj" "instance:reportOutputs" "instance:correct" "instance:maintainable" "instance:portable";
    }
    "instance:predictTrajectory" [shape=box, color=black, style=filled, fillcolor="darkgoldenrod1", label="GS:predictTrajectory"];
    "instance:determineDetectorOutcome" [shape=box, color=black, style=filled, fillcolor="darkgoldenrod1", label="GS:determineDetectorOutcome"];
    subgraph "GS" {
        rank="same";
        "instance:predictTrajectory" "instance:determineDetectorOutcome";
    }
}